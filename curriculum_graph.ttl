# ─────────────────────────────────────────────────────────────
#  DOCUMENT → COURSE LINKS
# ─────────────────────────────────────────────────────────────

doc:wstep_do_matematyki_i_informatyki ex:describes course:wstep_do_matematyki_i_informatyki .
doc:wstep_do_systemu_unix ex:describes course:wstep_do_systemu_unix .
doc:wstep_do_programowania ex:describes course:wstep_do_programowania .
doc:wstep_do_algorytmow
    ex:describes course:wstep_do_algorytmow_I ;
    ex:describes course:wstep_do_algorytmow_II .
doc:analiza_matematyczna
    ex:describes course:analiza_matematyczna_I ;
    ex:describes course:analiza_matematyczna_II .
doc:algebra_liniowa
    ex:describes course:algebra_liniowa_I ;
    ex:describes course:algebra_liniowa_II .
doc:matematyka_dyskretna ex:describes course:matematyka_dyskretna .
doc:programowanie_wspolbiezne ex:describes course:programowanie_wspolbiezne .

doc:README
    ex:mentions course:wstep_do_matematyki_i_informatyki ,
    course:wstep_do_systemu_unix ,
    course:wstep_do_programowania ,
    course:wstep_do_algorytmow_I ,
    course:analiza_matematyczna_I ,
    course:algebra_liniowa_I ,
    course:projektowy_c ,
    course:wstep_do_html_css_js ,
    course:matematyka_dyskretna ,
    course:wstep_do_algorytmow_II ,
    course:analiza_matematyczna_II ,
    course:algebra_liniowa_II .

# ─────────────────────────────────────────────────────────────
#  COURSE-LEVEL PREREQUISITE / SUPPORT RELATIONS
#  (reified with confidence and evidence)
# ─────────────────────────────────────────────────────────────

# --- WMI → Matematyka dyskretna (preparesFor, confidence 0.92) ---
[] a rdf:Statement ;
    rdf:subject   course:wstep_do_matematyki_i_informatyki ;
    rdf:predicate ex:preparesFor ;
    rdf:object    course:matematyka_dyskretna ;
    ex:confidence    "0.92"^^xsd:decimal ;
    ex:evidenceNote  "README.md explicitly states that Matematyka dyskretna is a 'kontynuacja wstępu do matematyki i informatyki'."@en ;
    ex:sourcePath    "README.md" .

course:wstep_do_matematyki_i_informatyki ex:preparesFor course:matematyka_dyskretna .

# --- AM I → AM II (requires, confidence 0.97) ---
[] a rdf:Statement ;
    rdf:subject   course:analiza_matematyczna_I ;
    rdf:predicate ex:requires ;
    rdf:object    course:analiza_matematyczna_II ;
    ex:confidence    "0.97"^^xsd:decimal ;
    ex:evidenceNote  "Single syllabus document split across part I (single-variable) and part II (multi-variable); sequential numbering implies strict prerequisite."@en ;
    ex:sourcePath    "analiza_matematyczna.md" .

course:analiza_matematyczna_I ex:requires course:analiza_matematyczna_II .

# --- AL I → AL II (requires, confidence 0.97) ---
[] a rdf:Statement ;
    rdf:subject   course:algebra_liniowa_I ;
    rdf:predicate ex:requires ;
    rdf:object    course:algebra_liniowa_II ;
    ex:confidence    "0.97"^^xsd:decimal ;
    ex:evidenceNote  "Single syllabus document; AL II builds on vectors (AL I) by introducing matrices, determinants, and linear transformations."@en ;
    ex:sourcePath    "algebra_liniowa.md" .

course:algebra_liniowa_I ex:requires course:algebra_liniowa_II .

# --- WdA I → WdA II (requires, confidence 0.95) ---
[] a rdf:Statement ;
    rdf:subject   course:wstep_do_algorytmow_I ;
    rdf:predicate ex:requires ;
    rdf:object    course:wstep_do_algorytmow_II ;
    ex:confidence    "0.95"^^xsd:decimal ;
    ex:evidenceNote  "Both described in a single document titled 'Wstęp do Algorytmów I i II'; WdA II introduces advanced data structures building on WdA I."@en ;
    ex:sourcePath    "wstęp_do_algorytmów.md" .

course:wstep_do_algorytmow_I ex:requires course:wstep_do_algorytmow_II .

# --- WMI → AM I (supports, confidence 0.80) ---
[] a rdf:Statement ;
    rdf:subject   course:wstep_do_matematyki_i_informatyki ;
    rdf:predicate ex:supports ;
    rdf:object    course:analiza_matematyczna_I ;
    ex:confidence    "0.80"^^xsd:decimal ;
    ex:evidenceNote  "WMI covers sets, functions, sequences, and induction – foundational concepts used throughout Mathematical Analysis I."@en ;
    ex:sourcePath    "wstęp_do_matematyki_i_informatyki.md, analiza_matematyczna.md" .

course:wstep_do_matematyki_i_informatyki ex:supports course:analiza_matematyczna_I .

# --- WMI → AL I (supports, confidence 0.75) ---
[] a rdf:Statement ;
    rdf:subject   course:wstep_do_matematyki_i_informatyki ;
    rdf:predicate ex:supports ;
    rdf:object    course:algebra_liniowa_I ;
    ex:confidence    "0.75"^^xsd:decimal ;
    ex:evidenceNote  "WMI introduces sets and functions which underlie vector space concepts. Weaker link because AL I focuses on geometric intuition."@en ;
    ex:sourcePath    "wstęp_do_matematyki_i_informatyki.md, algebra_liniowa.md" .

course:wstep_do_matematyki_i_informatyki ex:supports course:algebra_liniowa_I .

# --- WMI → WdA I (supports, confidence 0.78) ---
[] a rdf:Statement ;
    rdf:subject   course:wstep_do_matematyki_i_informatyki ;
    rdf:predicate ex:supports ;
    rdf:object    course:wstep_do_algorytmow_I ;
    ex:confidence    "0.78"^^xsd:decimal ;
    ex:evidenceNote  "WMI covers induction and basic logic needed for correctness proofs in WdA I (loop invariants, recursion correctness)."@en ;
    ex:sourcePath    "wstęp_do_matematyki_i_informatyki.md, wstęp_do_algorytmów.md" .

course:wstep_do_matematyki_i_informatyki ex:supports course:wstep_do_algorytmow_I .

# --- Unix → WdP (supports, confidence 0.78) ---
[] a rdf:Statement ;
    rdf:subject   course:wstep_do_systemu_unix ;
    rdf:predicate ex:supports ;
    rdf:object    course:wstep_do_programowania ;
    ex:confidence    "0.78"^^xsd:decimal ;
    ex:evidenceNote  "README states Unix teaches the development environment; WdP focuses on tools and workflow (git, CMake, linters) that operate on Unix."@en ;
    ex:sourcePath    "README.md" .

course:wstep_do_systemu_unix ex:supports course:wstep_do_programowania .

# --- WdP → WdA I (supports, confidence 0.82) ---
[] a rdf:Statement ;
    rdf:subject   course:wstep_do_programowania ;
    rdf:predicate ex:supports ;
    rdf:object    course:wstep_do_algorytmow_I ;
    ex:confidence    "0.82"^^xsd:decimal ;
    ex:evidenceNote  "WdP covers good programming practices, testing, and tooling; WdA I requires students to implement algorithms in C."@en ;
    ex:sourcePath    "wstęp_do_programowania.md, wstęp_do_algorytmów.md" .

course:wstep_do_programowania ex:supports course:wstep_do_algorytmow_I .

# --- MD → WdA II (supports, confidence 0.88) ---
[] a rdf:Statement ;
    rdf:subject   course:matematyka_dyskretna ;
    rdf:predicate ex:supports ;
    rdf:object    course:wstep_do_algorytmow_II ;
    ex:confidence    "0.88"^^xsd:decimal ;
    ex:evidenceNote  "README notes that Discrete Mathematics enables treatment of recursive data structures (lists, binary trees) introduced in WdA II."@en ;
    ex:sourcePath    "README.md" .

course:matematyka_dyskretna ex:supports course:wstep_do_algorytmow_II .

# --- AM I → AM II cross-dependency with AL II (relatedTo, confidence 0.75) ---
[] a rdf:Statement ;
    rdf:subject   course:algebra_liniowa_II ;
    rdf:predicate ex:relatedTo ;
    rdf:object    course:analiza_matematyczna_II ;
    ex:confidence    "0.75"^^xsd:decimal ;
    ex:evidenceNote  "analiza_matematyczna.md explicitly cross-references Jakobimatrix dependency on AL II. Relation is bidirectional thematic overlap."@en ;
    ex:sourcePath    "analiza_matematyczna.md, algebra_liniowa.md" .

course:algebra_liniowa_II ex:relatedTo course:analiza_matematyczna_II .

# --- WdA II → Programowanie współbieżne (preparesFor, confidence 0.70) ---
[] a rdf:Statement ;
    rdf:subject   course:wstep_do_algorytmow_II ;
    rdf:predicate ex:preparesFor ;
    rdf:object    course:programowanie_wspolbiezne ;
    ex:confidence    "0.70"^^xsd:decimal ;
    ex:evidenceNote  "PW covers lock-free data structures (Treiber stack, Michael-Scott queue) which require deep understanding of advanced data structures."@en ;
    ex:sourcePath    "programowanie_współbieżne.md, wstęp_do_algorytmów.md" .

course:wstep_do_algorytmow_II ex:preparesFor course:programowanie_wspolbiezne .

# --- WdP → Projektowy c (preparesFor, confidence 0.85) ---
[] a rdf:Statement ;
    rdf:subject   course:wstep_do_programowania ;
    rdf:predicate ex:preparesFor ;
    rdf:object    course:projektowy_c ;
    ex:confidence    "0.85"^^xsd:decimal ;
    ex:evidenceNote  "Projektowy c requires ~1000 line projects; WdP teaches project workflow (git, CMake, testing, code review)."@en ;
