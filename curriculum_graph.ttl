@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:       <https://github.com/IS-UMK/sylabusy/ontology#> .
@prefix course:   <https://github.com/IS-UMK/sylabusy/course/> .
@prefix topic:    <https://github.com/IS-UMK/sylabusy/topic/> .
@prefix lo:       <https://github.com/IS-UMK/sylabusy/outcome/> .
@prefix sem:      <https://github.com/IS-UMK/sylabusy/semester/> .
@prefix prog:     <https://github.com/IS-UMK/sylabusy/program/> .
@prefix doc:      <https://github.com/IS-UMK/sylabusy/doc/> .

# ─────────────────────────────────────────────────────────────
#  ONTOLOGY DEFINITION
# ─────────────────────────────────────────────────────────────

ex:Course a rdfs:Class ;
    rdfs:label "Course"@en , "Przedmiot"@pl .

ex:Topic a rdfs:Class ;
    rdfs:label "Topic"@en , "Temat"@pl .

ex:LearningOutcome a rdfs:Class ;
    rdfs:label "LearningOutcome"@en , "Efekt kształcenia"@pl .

ex:Semester a rdfs:Class ;
    rdfs:label "Semester"@en , "Semestr"@pl .

ex:Program a rdfs:Class ;
    rdfs:label "Study Program"@en , "Program studiów"@pl .

# ── Course-level properties ──────────────────────────────────

ex:covers a rdf:Property ;
    rdfs:label "covers"@en ;
    rdfs:comment "A course covers a topic."@en ;
    rdfs:domain ex:Course ;
    rdfs:range ex:Topic .

ex:requires a rdf:Property ;
    rdfs:label "requires"@en ;
    rdfs:comment "Strong prerequisite: one course requires another."@en ;
    rdfs:domain ex:Course ;
    rdfs:range ex:Course .

ex:preparesFor a rdf:Property ;
    rdfs:label "preparesFor"@en ;
    rdfs:comment "One course provides useful foundation for another without being mandatory."@en ;
    rdfs:domain ex:Course ;
    rdfs:range ex:Course .

ex:supports a rdf:Property ;
    rdfs:label "supports"@en ;
    rdfs:comment "Partial or auxiliary background relation between courses."@en ;
    rdfs:domain ex:Course ;
    rdfs:range ex:Course .

ex:relatedTo a rdf:Property ;
    rdfs:label "relatedTo"@en ;
    rdfs:comment "Thematic overlap between courses or topics."@en .

ex:offeredInSemester a rdf:Property ;
    rdfs:label "offeredInSemester"@en ;
    rdfs:domain ex:Course ;
    rdfs:range ex:Semester .

# ── Topic-level properties ───────────────────────────────────

ex:dependsOn a rdf:Property ;
    rdfs:label "dependsOn"@en ;
    rdfs:comment "Understanding one topic plausibly requires understanding another."@en ;
    rdfs:domain ex:Topic ;
    rdfs:range ex:Topic .

# ── Document relations ───────────────────────────────────────

ex:describes a rdf:Property ;
    rdfs:label "describes"@en ;
    rdfs:domain foaf:Document ;
    rdfs:range ex:Course .

ex:mentions a rdf:Property ;
    rdfs:label "mentions"@en ;
    rdfs:domain foaf:Document .

# ── Learning outcome relations ───────────────────────────────

ex:hasLearningOutcome a rdf:Property ;
    rdfs:label "hasLearningOutcome"@en ;
    rdfs:domain ex:Course ;
    rdfs:range ex:LearningOutcome .

ex:mapsTo a rdf:Property ;
    rdfs:label "mapsTo"@en ;
    rdfs:comment "A learning outcome maps to a topic."@en ;
    rdfs:domain ex:LearningOutcome ;
    rdfs:range ex:Topic .

# ── Evidence properties ──────────────────────────────────────

ex:confidence a rdf:Property ;
    rdfs:label "confidence"@en ;
    rdfs:comment "Confidence score [0.0, 1.0] for an inferred relation."@en ;
    rdfs:range xsd:decimal .

ex:evidenceNote a rdf:Property ;
    rdfs:label "evidenceNote"@en ;
    rdfs:range xsd:string .

ex:sourcePath a rdf:Property ;
    rdfs:label "sourcePath"@en ;
    rdfs:range xsd:string .

# ─────────────────────────────────────────────────────────────
#  STUDY PROGRAM
# ─────────────────────────────────────────────────────────────

prog:inzynieria_informatyczna a ex:Program ;
    skos:prefLabel "Studia inżynierskie – Informatyka"@pl ,
                   "Computer Science Engineering Program"@en ;
    dcterms:description "Two-year foundational program followed by 1.5-year specialisation and thesis."@en ;
    ex:sourcePath "README.md" .

# ─────────────────────────────────────────────────────────────
#  SEMESTERS
# ─────────────────────────────────────────────────────────────

sem:semestr_I a ex:Semester ;
    skos:prefLabel "Semestr I"@pl , "Semester I"@en ;
    rdfs:comment "First semester – all courses obligatory."@pl .

sem:semestr_II a ex:Semester ;
    skos:prefLabel "Semestr II"@pl , "Semester II"@en ;
    rdfs:comment "Second semester – all courses obligatory."@pl .

# ─────────────────────────────────────────────────────────────
#  DOCUMENTS
# ─────────────────────────────────────────────────────────────

doc:README a foaf:Document ;
    skos:prefLabel "README.md"@en ;
    ex:sourcePath "README.md" ;
    dcterms:description "Main curriculum overview: study goals, calendar, semester structure."@en .

doc:algebra_liniowa a foaf:Document ;
    skos:prefLabel "algebra_liniowa.md"@en ;
    ex:sourcePath "algebra_liniowa.md" .

doc:analiza_matematyczna a foaf:Document ;
    skos:prefLabel "analiza_matematyczna.md"@en ;
    ex:sourcePath "analiza_matematyczna.md" .

doc:matematyka_dyskretna a foaf:Document ;
    skos:prefLabel "matematyka_dyskretna.md"@en ;
    ex:sourcePath "matematyka_dyskretna.md" .

doc:wstep_do_algorytmow a foaf:Document ;
    skos:prefLabel "wstęp_do_algorytmów.md"@en ;
    ex:sourcePath "wstęp_do_algorytmów.md" .

doc:wstep_do_matematyki_i_informatyki a foaf:Document ;
    skos:prefLabel "wstęp_do_matematyki_i_informatyki.md"@en ;
    ex:sourcePath "wstęp_do_matematyki_i_informatyki.md" .

doc:wstep_do_programowania a foaf:Document ;
    skos:prefLabel "wstęp_do_programowania.md"@en ;
    ex:sourcePath "wstęp_do_programowania.md" .

doc:wstep_do_systemu_unix a foaf:Document ;
    skos:prefLabel "wstęp_do_systemu_unix.md"@en ;
    ex:sourcePath "wstęp_do_systemu_unix.md" .

doc:programowanie_wspolbiezne a foaf:Document ;
    skos:prefLabel "programowanie_współbieżne.md"@en ;
    ex:sourcePath "programowanie_współbieżne.md" .

# ─────────────────────────────────────────────────────────────
#  COURSES  –  SEMESTER I
# ─────────────────────────────────────────────────────────────

course:wstep_do_matematyki_i_informatyki a ex:Course ;
    skos:prefLabel "Wstęp do matematyki i informatyki"@pl ,
                   "Introduction to Mathematics and Computer Science"@en ;
    skos:altLabel "WMI"@pl ;
    ex:offeredInSemester sem:semestr_I ;
    dcterms:references doc:wstep_do_matematyki_i_informatyki ;
    ex:covers
        topic:indukcja_matematyczna ,
        topic:logika_i_rachunek_zdan ,
        topic:kwantyfikatory ,
        topic:funkcje_i_ich_wlasnosci ,
        topic:zbior_i_operacje_na_zbiorach ,
        topic:relacje_i_relacje_rownowaznosci ,
        topic:porzadki .

course:wstep_do_systemu_unix a ex:Course ;
    skos:prefLabel "Wstęp do systemu Unix"@pl ,
                   "Introduction to Unix System"@en ;
    skos:altLabel "Unix"@pl ;
    ex:offeredInSemester sem:semestr_I ;
    dcterms:references doc:wstep_do_systemu_unix ;
    ex:covers
        topic:bash_i_komendy_systemowe ,
        topic:system_plikow_unix ,
        topic:zarzadzanie_procesami_unix ,
        topic:skrypty_bashowe .

course:wstep_do_programowania a ex:Course ;
    skos:prefLabel "Wstęp do programowania"@pl ,
                   "Introduction to Programming"@en ;
    skos:altLabel "WdP"@pl ;
    ex:offeredInSemester sem:semestr_I ;
    dcterms:references doc:wstep_do_programowania ;
    ex:covers
        topic:git_i_github ,
        topic:zasady_dobrego_programowania ,
        topic:narzedzia_wspomagajace_programowanie ,
        topic:debugowanie ,
        topic:testowanie .

course:wstep_do_algorytmow_I a ex:Course ;
    skos:prefLabel "Wstęp do algorytmów I"@pl ,
                   "Introduction to Algorithms I"@en ;
    skos:altLabel "WdA I"@pl ;
    ex:offeredInSemester sem:semestr_I ;
    dcterms:references doc:wstep_do_algorytmow ;
    ex:covers
        topic:podstawy_programowania ,
        topic:dowodzenie_poprawnosci_programow ,
        topic:tablice ,
        topic:rekurencja ,
        topic:pamiec_dynamiczna .

course:analiza_matematyczna_I a ex:Course ;
    skos:prefLabel "Analiza matematyczna I"@pl ,
                   "Mathematical Analysis I"@en ;
    skos:altLabel "AM I"@pl ;
    ex:offeredInSemester sem:semestr_I ;
    dcterms:references doc:analiza_matematyczna ;
    ex:covers
        topic:ciagi_i_szeregi ,
        topic:granica_i_ciaglosc ,
        topic:pochodna_jednej_zmiennej ,
        topic:calka_riemanna ,
        topic:asymptotyka_o_bachmann_landau ,
        topic:wzor_taylora ,
        topic:szeregi_potegowe .

course:algebra_liniowa_I a ex:Course ;
    skos:prefLabel "Algebra liniowa I"@pl ,
                   "Linear Algebra I"@en ;
    skos:altLabel "AL I"@pl ;
    ex:offeredInSemester sem:semestr_I ;
    dcterms:references doc:algebra_liniowa ;
    ex:covers
        topic:wektory_w_przestrzeniach_euklidesowych ,
        topic:iloczyn_skalarny ,
        topic:liniowa_niezaleznosc_i_bazy ,
