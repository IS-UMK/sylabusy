#  CROSS-CUTTING TOPIC RELATIONS (SKOS)
# ─────────────────────────────────────────────────────────────

# Asymptotic notation is shared between AM I and MD
topic:asymptotyka_o_bachmann_landau skos:related topic:zlozonosc_algorytmow .

# Recursion appears in both MD and WdA
topic:rekurencja skos:related topic:drzewa_binarne .

# Gradient descent bridges AM II and ML applications
topic:metoda_najszybszego_spadku skos:related topic:uklady_rownan_liniowych .

# Convexity in vectors relates to convexity in analysis
topic:wypukloc_wektory skos:related topic:gradient_i_ekstrema .
